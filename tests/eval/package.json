{
  "name": "supabase-architect-eval",
  "version": "1.0.0",
  "private": true,
  "description": "Eval runner para a skill Supabase Architect",
  "type": "module",
  "scripts": {
    "eval": "tsx runner.ts",
    "eval:smoke": "tsx runner.ts --only P01,P04,P06,P11",

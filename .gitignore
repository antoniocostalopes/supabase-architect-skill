# Supabase Architect — .gitignore

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
*.sublime-workspace
*.sublime-project

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node (apenas para tests/eval/)
**/node_modules/
**/.npm/
**/.yarn/
**/.pnpm-store/

# Env files (NEVER commit secrets)
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
!**/.env.example

# Test outputs — manter README.md mas ignorar resultados individuais
tests/results/*.md
!tests/results/README.md

# Build artifacts (caso futuramente surjam)
dist/
build/
out/
*.tsbuildinfo

# Coverage
coverage/
.nyc_output/

# Claude Code local workspace settings (não distribuir)
.claude/

# Claude Code global install dir (não pertence ao repo)
~/.claude/

# Misc
*.bak
*.tmp
.cache/
